  try{var u=JSON.parse(localStorage.getItem('tgU')||'{}');if(u[ph+'_passenger']){u[ph+'_passenger'].walletBalance=newBal;localStorage.setItem('tgU',JSON.stringify(u));}}catch(e){}
  gCH(me.phone,function(h){
    h.unshift({dt:new Date().toLocaleString('en-IN'),pid:pid,nm:nm,type:'Deduct',pl:'Trip: '+fromName+' → '+toName,am:fare,cash:fare,exp:'Bal: ₹'+newBal,cid:me.condId});
    sCH(me.phone,h);
  });
  crst.n++;crst.tot+=fare;
  el('cRn').textContent=crst.n;el('cCa').textContent='₹'+crst.tot;
  el('cWBal').textContent='💰 Wallet Balance: ₹'+newBal;
  el('fcBal').textContent='Passenger wallet: ₹'+newBal;
  el('fcWarn').style.display='none';el('cWDeduct').disabled=true;
  al('cWA','✅ ₹'+fare+' deducted for '+dist+'km ('+fromName+' → '+toName+'). Balance: ₹'+newBal,'s');
  loadCHist();
});

el('cqaRow').addEventListener('click',function(e){
  var btn=e.target.closest('.qa-btn');if(!btn)return;
  el('cWCI').value=btn.dataset.camt;
  el('cqaRow').querySelectorAll('.qa-btn').forEach(function(b){b.classList.remove('sel');});
  btn.classList.add('sel');
});

el('cWBtn').addEventListener('click',function(){
  var box=el('cWPR');
  if(!box.classList.contains('show')){al('cWA','Search for a passenger first!','e');return;}
  var amt=parseInt(el('cWCI').value)||0;
  if(amt<10){al('cWA','Minimum top-up is ₹10!','e');return;}
  var ph=box.dataset.ph,pid=box.dataset.pid,nm=box.dataset.nm;
  if(!cWPassenger){al('cWA','Passenger not found!','e');return;}
  cWPassenger.walletBalance=(cWPassenger.walletBalance||0)+amt;
  var newBal=cWPassenger.walletBalance;
  db.collection('tgrtc_users').doc(ph+'_passenger').update({walletBalance:newBal});
  try{var u=JSON.parse(localStorage.getItem('tgU')||'{}');if(u[ph+'_passenger']){u[ph+'_passenger'].walletBalance=newBal;localStorage.setItem('tgU',JSON.stringify(u));}}catch(e){}
  gCH(me.phone,function(h){
    h.unshift({dt:new Date().toLocaleString('en-IN'),pid:pid,nm:nm,type:'Wallet',pl:'Wallet Top-Up',am:amt,cash:amt,exp:'Bal: ₹'+newBal,cid:me.condId});
    sCH(me.phone,h);
  });
  crst.n++;crst.tot+=amt;
  el('cRn').textContent=crst.n;el('cCa').textContent='₹'+crst.tot;
  el('cWBal').textContent='💰 Wallet Balance: ₹'+newBal;
  al('cWA','✅ ₹'+amt+" added to "+nm+"'s wallet! Balance: ₹"+newBal,'s');
  el('cWCI').value='';
  el('cqaRow').querySelectorAll('.qa-btn').forEach(function(b){b.classList.remove('sel');});
  loadCHist();
});

// ── CONDUCTOR BLOCK CARD ──
el('cBSearch').addEventListener('click',searchCB);
el('cBPh').addEventListener('keyup',function(e){if(e.key==='Enter')searchCB();});
function searchCB(){
  var q=el('cBPh').value.trim();if(!q)return;
  db.collection('tgrtc_users').doc(q+'_passenger').get().then(function(doc){
    var box=el('cBPR');
    if(doc.exists){
      var f=doc.data();
      el('cBPN').textContent=f.name;
      el('cBPid').textContent='Pass ID: '+f.passId+' | 📱 '+f.phone;
      var photoEl=el('cBPhoto');
      if(f.photo&&f.photo.length>10){photoEl.innerHTML='<img src="'+f.photo+'" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" alt="photo">';}
      else{photoEl.textContent=f.name.charAt(0).toUpperCase();}
      if(f.blocked){
        el('cBSt').style.cssText='padding:10px 14px;border-radius:10px;font-size:13px;font-weight:700;margin-bottom:12px;background:#fef2f2;color:#dc2626;border:1px solid #fecaca';
        el('cBSt').textContent='⛔ STATUS: BLOCKED';
      } else {
        el('cBSt').style.cssText='padding:10px 14px;border-radius:10px;font-size:13px;font-weight:700;margin-bottom:12px;background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0';
        el('cBSt').textContent='● STATUS: ACTIVE';
      }
      box.dataset.ph=f.phone;box.dataset.nm=f.name;
      box.classList.add('show');
    } else {
      al('cBA','❌ Passenger not found!','e');box.classList.remove('show');
    }
  }).catch(function(){al('cBA','Connection error!','e');});
}

el('cDoBlock').addEventListener('click',function(){
  var box=el('cBPR');if(!box.classList.contains('show')){al('cBA','Search for a passenger first!','e');return;}
  var ph=box.dataset.ph,nm=box.dataset.nm;
  db.collection('tgrtc_users').doc(ph+'_passenger').update({blocked:true});
  try{var u=JSON.parse(localStorage.getItem('tgU')||'{}');if(u[ph+'_passenger']){u[ph+'_passenger'].blocked=true;localStorage.setItem('tgU',JSON.stringify(u));}}catch(e){}
  el('cBSt').style.cssText='padding:10px 14px;border-radius:10px;font-size:13px;font-weight:700;margin-bottom:12px;background:#fef2f2;color:#dc2626;border:1px solid #fecaca';
  el('cBSt').textContent='⛔ STATUS: BLOCKED';
  al('cBA','🔒 '+nm+"'s card blocked!",'e');
});

el('cDoUnblock').addEventListener('click',function(){
  var box=el('cBPR');if(!box.classList.contains('show')){al('cBA','Search for a passenger first!','e');return;}
  var ph=box.dataset.ph,nm=box.dataset.nm;
  db.collection('tgrtc_users').doc(ph+'_passenger').update({blocked:false});
  try{var u=JSON.parse(localStorage.getItem('tgU')||'{}');if(u[ph+'_passenger']){u[ph+'_passenger'].blocked=false;localStorage.setItem('tgU',JSON.stringify(u));}}catch(e){}
  el('cBSt').style.cssText='padding:10px 14px;border-radius:10px;font-size:13px;font-weight:700;margin-bottom:12px;background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0';
  el('cBSt').textContent='● STATUS: ACTIVE';
  al('cBA','🔓 '+nm+"'s card unblocked!",'s');
});

function loadCHist(){
  if(!me)return;
  gCH(me.phone,function(h){
    var tb=el('cHB');if(!tb)return;
    if(!h.length){tb.innerHTML='<tr><td colspan="5" class="te">No transactions yet</td></tr>';el('cHT').textContent='₹0';return}
    tb.innerHTML='';var tot=0;
    h.forEach(function(r){
      tot+=r.am;
      var tr=document.createElement('tr');
      var tc=r.type==='Wallet'?'color:#0891b2':r.type==='Deduct'?'color:#dc2626':'color:#16a34a';
      tr.innerHTML='<td style="font-size:11px">'+r.dt+'</td>'
        +'<td>'+r.nm+'<br><span style="font-size:11px;color:#94a3b8">'+r.pid+'</span></td>'
        +'<td><span style="'+tc+';font-weight:700">'+r.type+'</span><br><span style="font-size:11px;color:#64748b">'+r.pl+'</span></td>'
        +'<td style="color:#16a34a;font-weight:700">₹'+r.am+'</td>'
        +'<td style="font-size:11px;color:#64748b">'+r.exp+'</td>';
      tb.appendChild(tr);
    });
    el('cHT').textContent='₹'+tot;
  });
}

// ── ADMIN ──
[0,1,2].forEach(function(i){
  el('atb'+i).addEventListener('click',function(){
    [0,1,2].forEach(function(j){el('atb'+j).classList.remove('on');el('at'+j).style.display='none';});
    this.classList.add('on');el('at'+i).style.display='block';
  });
});

function loadAdmin(){
  db.collection('tgrtc_users').get().then(function(snap){
    var ps=[];
    snap.forEach(function(doc){var d=doc.data();if(d.role==='passenger')ps.push(d);});
    el('aT').textContent=ps.length;
    el('aAc').textContent=ps.filter(function(p){return !p.blocked&&p.expiry;}).length;
    el('aBl').textContent=ps.filter(function(p){return p.blocked;}).length;
    el('aNp').textContent=ps.filter(function(p){return !p.expiry&&!p.blocked;}).length;
    var tb=el('aPB');if(!tb)return;
    if(!ps.length){tb.innerHTML='<tr><td colspan="7" class="te">No passengers registered yet</td></tr>';return}
    tb.innerHTML='';
    ps.forEach(function(p){
      var rt=parseRoute(p.route);
      var st=p.blocked?'<span style="color:#d97706">⛔ Blocked</span>':p.expiry?'<span style="color:#16a34a">✅ Active</span>':'<span style="color:#94a3b8">○ No Pass</span>';
      var ac=p.blocked
        ?'<button style="padding:5px 12px;border:none;border-radius:8px;cursor:pointer;font-size:12px;font-weight:700;background:linear-gradient(135deg,#059669,#10b981);color:#fff" data-ph="'+p.phone+'" data-bl="0">🔓 Unblock</button>'
        :'<button style="padding:5px 12px;border:none;border-radius:8px;cursor:pointer;font-size:12px;font-weight:700;background:linear-gradient(135deg,#b91c1c,#ef4444);color:#fff" data-ph="'+p.phone+'" data-bl="1">🔒 Block</button>';
      var tr=document.createElement('tr');
      tr.innerHTML='<td>'+p.name+'</td>'
        +'<td style="font-size:11px">'+p.passId+'</td>'
        +'<td style="font-size:12px">'+rt.no+' — '+rt.display+'</td>'
        +'<td style="font-size:12px">'+(p.expiry||'<span style="color:#dc2626">—</span>')+'</td>'
        +'<td style="color:#16a34a;font-weight:700">₹'+(p.walletBalance||0)+'</td>'
        +'<td>'+st+'</td><td>'+ac+'</td>';
      tb.appendChild(tr);
    });
  });
}

el('aPB').addEventListener('click',function(e){
  var btn=e.target.closest('[data-ph]');if(!btn)return;
  var ph=btn.dataset.ph,bl=btn.dataset.bl==='1';
  db.collection('tgrtc_users').doc(ph+'_passenger').update({blocked:bl}).then(function(){
    al('aPA',bl?'🔒 Card blocked!':'🔓 Card unblocked!',bl?'e':'s');loadAdmin();
  });
});

el('aCBtn').addEventListener('click',searchCond);
el('aCQ').addEventListener('keyup',function(e){if(e.key==='Enter')searchCond();});
function searchCond(){
  var q=el('aCQ').value.trim().toLowerCase();
  if(!q){al('aCA','Please enter Conductor ID or phone!','e');return}
  db.collection('tgrtc_users').get().then(function(snap){
    var f=null;
    snap.forEach(function(doc){
      var d=doc.data();
      if(d.role==='conductor'&&(d.phone===q||(d.condId&&d.condId.toLowerCase()===q)))f=d;
    });
    var info=el('aCInfo'),tbl=el('aCTbl'),emp=el('aCEmp');
    if(!f){al('aCA','❌ Conductor not found!','e');info.classList.remove('show');tbl.style.display='none';emp.style.display='block';return}
    var rt=parseRoute(f.route);
    el('aCNm').textContent='🎫 '+f.name+' ('+(f.condId||'N/A')+')';
    el('aCRt').textContent='🛣️ '+rt.no+' — '+rt.display;
    gCH(f.phone,function(h){
      el('aCCnt').textContent=h.length;
      var tb2=el('aCBody');tb2.innerHTML='';var tot=0;
      if(!h.length){tb2.innerHTML='<tr><td colspan="5" class="te">No transactions for this conductor</td></tr>';}
      else{
        h.forEach(function(r){
          tot+=r.am;
          var tr=document.createElement('tr');
          var tc=r.type==='Wallet'?'color:#0891b2':r.type==='Deduct'?'color:#dc2626':'color:#16a34a';
          tr.innerHTML='<td style="font-size:11px">'+r.dt+'</td>'
            +'<td>'+r.nm+'<br><span style="font-size:11px;color:#94a3b8">'+r.pid+'</span></td>'
            +'<td><span style="'+tc+';font-weight:700">'+(r.type||'Pass')+'</span><br><span style="font-size:11px;color:#64748b">'+r.pl+'</span></td>'
            +'<td style="color:#16a34a;font-weight:700">₹'+r.am+'</td>'
            +'<td style="font-size:11px;color:#64748b">'+r.exp+'</td>';
          tb2.appendChild(tr);
        });
      }
      el('aCTot').textContent='₹'+tot;
      info.classList.add('show');tbl.style.display='table';emp.style.display='none';
    });
  });
}

el('aABtn').addEventListener('click',function(){
  var n=el('aN').value.trim(),ph=el('aPh').value.trim(),rt=el('aRt').value;
  var plv=el('aPl').value,sd=el('aDt').value;
  if(!n||!ph||!rt||!sd){al('aAA','Please fill Name, Phone, Route & Date!','e');return}
  if(!/^[0-9]{10}$/.test(ph)){al('aAA','Enter a valid 10-digit phone number!','e');return}
  var key=ph+'_passenger';
  db.collection('tgrtc_users').doc(key).get().then(function(doc){
    if(doc.exists){al('aAA','An account with this phone already exists!','e');return}
    var mo=plv==='day'?0:plv==='month'?1:3;
    var d=new Date(sd);if(mo===0){d.setDate(d.getDate()+1);}else{d.setMonth(d.getMonth()+mo);}
    var exp=d.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'});
    var yr=new Date().getFullYear();
    var pid='TGRTC-'+yr+'-'+String(Date.now()).slice(-5);
    var pln=plv==='day'?'Day Pass':plv==='month'?'Monthly Pass':'3-Month Pass';
    var data={name:n,phone:ph,password:ph.slice(-4),role:'passenger',route:rt,passId:pid,condId:'',expiry:exp,cardType:pln+' Pass',blocked:false,photo:'',walletBalance:0};
    sUKey(key,data);
    al('aAA','✅ Pass created! ID: '+pid+' | Default password: '+ph.slice(-4),'s');
    el('aN').value='';el('aPh').value='';loadAdmin();
  });
});

var aDtEl=el('aDt');if(aDtEl)aDtEl.valueAsDate=new Date();

})();
</script>
