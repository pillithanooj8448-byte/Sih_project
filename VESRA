<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>TGRTC Smart Bus Pass</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:Arial,sans-serif;background:#f0f4f8;color:#1e293b;min-height:100vh;}
.page{display:none;min-height:100vh;flex-direction:column;}
.page.active{display:flex;}
body::before{content:'';position:fixed;inset:0;background:radial-gradient(ellipse at 15% 15%,rgba(59,130,246,0.06),transparent 55%),radial-gradient(ellipse at 85% 85%,rgba(6,182,212,0.05),transparent 55%);pointer-events:none;z-index:0;}

/* LANDING */
#landing{align-items:center;justify-content:center;padding:2rem;text-align:center;position:relative;z-index:1;}
.brand-chip{display:inline-block;padding:6px 18px;border-radius:999px;background:rgba(37,99,235,0.1);border:1px solid rgba(59,130,246,0.3);color:#2563eb;font-size:11px;letter-spacing:4px;margin-bottom:20px;}
h1.hero{font-size:clamp(2rem,6vw,3.5rem);font-weight:900;line-height:1.1;letter-spacing:-1px;margin-bottom:14px;background:linear-gradient(135deg,#1e293b 30%,#2563eb 65%,#0891b2);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.hero-sub{color:#64748b;font-size:15px;margin-bottom:40px;max-width:420px;line-height:1.7;}
.pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;max-width:780px;width:100%;}
@media(max-width:620px){.pgrid{grid-template-columns:1fr;max-width:320px;}}
.pcard{background:#fff;border:1px solid #e2e8f0;border-radius:20px;padding:28px 20px;cursor:pointer;transition:all .3s;box-shadow:0 2px 8px rgba(0,0,0,0.06);}
.pcard:hover{transform:translateY(-6px);border-color:#3b82f6;box-shadow:0 8px 28px rgba(37,99,235,0.15);}
.pcard-icon{width:50px;height:50px;border-radius:14px;margin:0 auto 14px;display:flex;align-items:center;justify-content:center;font-size:22px;}
.ic-b{background:rgba(37,99,235,0.1);border:1px solid rgba(59,130,246,0.25);}
.ic-g{background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.25);}
.ic-y{background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.25);}
.pcard h3{font-size:14px;font-weight:700;letter-spacing:2px;margin-bottom:8px;color:#1e293b;}
.pcard p{font-size:12px;color:#64748b;line-height:1.6;margin-bottom:18px;}
.pc-btn{width:100%;padding:10px;border:none;border-radius:10px;font-size:13px;font-weight:700;letter-spacing:1px;cursor:pointer;transition:all .25s;}
.pb-b{background:linear-gradient(135deg,#1d4ed8,#3b82f6);color:#fff;}
.pb-g{background:linear-gradient(135deg,#059669,#10b981);color:#fff;}
.pb-y{background:linear-gradient(135deg,#d97706,#fbbf24);color:#000;}
.pc-btn:hover{filter:brightness(1.1);}

/* AUTH */
#auth{align-items:center;justify-content:center;padding:2rem;position:relative;z-index:1;}
.abox{width:100%;max-width:420px;background:#fff;border:1px solid #e2e8f0;border-radius:22px;padding:32px;box-shadow:0 8px 32px rgba(0,0,0,0.08);}
.role-chip{display:inline-block;padding:4px 14px;border-radius:999px;font-size:11px;letter-spacing:2px;margin-bottom:12px;}
.rc-p{background:rgba(59,130,246,0.1);color:#2563eb;border:1px solid rgba(59,130,246,0.3);}
.rc-c{background:rgba(16,185,129,0.1);color:#059669;border:1px solid rgba(16,185,129,0.28);}
.rc-a{background:rgba(245,158,11,0.1);color:#d97706;border:1px solid rgba(245,158,11,0.28);}
.abox h2{font-size:24px;font-weight:800;margin-bottom:4px;color:#1e293b;}
.abox .asub{font-size:13px;color:#64748b;margin-bottom:22px;}
.alert{padding:10px 14px;border-radius:10px;font-size:13px;margin-bottom:14px;display:none;}
.alert.show{display:block;}
.ae{background:#fef2f2;border:1px solid #fecaca;color:#dc2626;}
.as{background:#f0fdf4;border:1px solid #bbf7d0;color:#16a34a;}
.fg{margin-bottom:14px;}
label{display:block;font-size:11px;letter-spacing:2px;color:#64748b;margin-bottom:6px;}
input,select{width:100%;padding:12px 14px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:11px;color:#1e293b;font-size:14px;outline:none;transition:border .25s;font-family:inherit;}
input:focus,select:focus{border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,0.1);background:#fff;}
input::placeholder{color:#94a3b8;}
select option{background:#fff;color:#1e293b;}
select optgroup{color:#0891b2;font-weight:700;}
.abtn{width:100%;padding:13px;border:none;border-radius:12px;font-size:15px;font-weight:700;letter-spacing:1px;cursor:pointer;background:linear-gradient(135deg,#1d4ed8,#3b82f6);color:#fff;margin-top:4px;transition:all .25s;}
.abtn:hover{filter:brightness(1.1);}
.alink{text-align:center;margin-top:14px;font-size:13px;color:#64748b;}
.alink span{color:#3b82f6;cursor:pointer;text-decoration:underline;}
.aback{text-align:center;margin-top:10px;font-size:12px;color:#94a3b8;cursor:pointer;}
.aback:hover{color:#1e293b;}

/* TOPBAR */
.topbar{background:#fff;border-bottom:1px solid #e2e8f0;padding:12px 24px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;box-shadow:0 1px 4px rgba(0,0,0,0.06);}
.tb-left{display:flex;align-items:center;gap:12px;}
.tb-logo{font-size:16px;font-weight:800;letter-spacing:1px;background:linear-gradient(135deg,#1e293b,#2563eb);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.tb-chip{padding:3px 10px;border-radius:999px;font-size:10px;letter-spacing:2px;}
.tb-right{display:flex;align-items:center;gap:12px;}
.tb-user{font-size:13px;color:#64748b;}
.lobtn{padding:5px 14px;background:transparent;border:1px solid #e2e8f0;border-radius:8px;color:#94a3b8;cursor:pointer;font-size:12px;transition:all .25s;}
.lobtn:hover{border-color:#ef4444;color:#ef4444;}

/* DASH */
.dbody{padding:24px;flex:1;position:relative;z-index:1;}
.dh{font-size:22px;font-weight:800;margin-bottom:4px;color:#1e293b;}
.ds{font-size:13px;color:#64748b;margin-bottom:22px;}
.srow{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;margin-bottom:22px;}
.sc{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:14px;box-shadow:0 1px 4px rgba(0,0,0,0.04);}
.sc-l{font-size:10px;letter-spacing:2px;color:#94a3b8;margin-bottom:6px;}
.sc-v{font-size:26px;font-weight:800;}
.vb{color:#2563eb;}.vg{color:#16a34a;}.vr{color:#dc2626;}.vy{color:#d97706;}.vc{color:#0891b2;}
.sect{background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:20px;margin-bottom:18px;box-shadow:0 1px 4px rgba(0,0,0,0.04);}
.sect-title{font-size:11px;font-weight:700;letter-spacing:3px;color:#0891b2;margin-bottom:16px;}
.tabs{display:flex;gap:6px;margin-bottom:18px;background:#f1f5f9;padding:5px;border-radius:12px;overflow-x:auto;}
.tb{padding:8px 16px;border:none;background:transparent;color:#94a3b8;cursor:pointer;border-radius:9px;font-size:13px;transition:all .22s;white-space:nowrap;font-family:inherit;}
.tb.on{background:#fff;color:#1e293b;font-weight:600;box-shadow:0 2px 8px rgba(0,0,0,0.08);}

/* PASS CARD */
.pass-card{background:linear-gradient(135deg,#1e3a8a,#1d4ed8,#0369a1);border-radius:20px;padding:22px;position:relative;overflow:hidden;margin-bottom:18px;box-shadow:0 8px 24px rgba(29,78,216,0.25);}
.pass-card::after{content:'TGRTC';position:absolute;bottom:-10px;right:16px;font-size:60px;font-weight:900;color:rgba(255,255,255,0.06);letter-spacing:4px;}
.pch{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;}
.pctag{font-size:10px;letter-spacing:3px;color:rgba(255,255,255,0.5);}
.pcst{padding:3px 10px;border-radius:999px;font-size:11px;font-weight:600;}
.st-on{background:rgba(16,185,129,0.25);color:#6ee7b7;border:1px solid rgba(110,231,183,0.4);}
.st-bl{background:rgba(245,158,11,0.25);color:#fcd34d;border:1px solid rgba(252,211,77,0.4);}
.st-no{background:rgba(255,255,255,0.12);color:rgba(255,255,255,0.6);border:1px solid rgba(255,255,255,0.2);}
.pcname{font-size:22px;font-weight:800;margin-bottom:4px;letter-spacing:1px;color:#fff;}
.pcid{font-size:11px;color:rgba(255,255,255,0.55);}
.pcrow{display:flex;gap:24px;flex-wrap:wrap;margin-top:16px;padding-top:16px;border-top:1px solid rgba(255,255,255,0.1);}
.pci label{font-size:10px;letter-spacing:2px;color:rgba(255,255,255,0.5);display:block;margin-bottom:4px;}
.pci span{font-size:13px;font-weight:600;color:#fff;}
.pc-photo{width:64px;height:64px;border-radius:50%;object-fit:cover;border:3px solid rgba(255,255,255,0.4);background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:800;color:#fff;flex-shrink:0;}

/* PLANS */
.planrow{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;}
.plan{flex:1;min-width:90px;padding:14px;background:#f8fafc;border:2px solid #e2e8f0;border-radius:12px;text-align:center;cursor:pointer;transition:all .25s;}
.plan:hover,.plan.on{border-color:#3b82f6;background:#eff6ff;}
.pln{font-size:12px;font-weight:700;margin-bottom:4px;color:#1e293b;}
.plp{color:#2563eb;font-size:16px;font-weight:800;}
.plt{font-size:10px;color:#16a34a;margin-top:3px;}

/* BTNS */
.btn{padding:10px 20px;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;transition:all .25s;font-family:inherit;}
.btn:hover{filter:brightness(1.1);transform:translateY(-1px);}
.bp{background:linear-gradient(135deg,#1d4ed8,#3b82f6);color:#fff;}
.bg{background:linear-gradient(135deg,#059669,#10b981);color:#fff;}
.bd{background:linear-gradient(135deg,#b91c1c,#ef4444);color:#fff;}
.bgh{background:transparent;border:1px solid #e2e8f0;color:#64748b;}
.bfw{width:100%;}
.brow{display:flex;gap:12px;flex-wrap:wrap;margin-top:14px;}

/* TABLE */
table{width:100%;border-collapse:collapse;}
th{text-align:left;padding:10px 14px;font-size:10px;letter-spacing:2px;color:#94a3b8;border-bottom:1px solid #e2e8f0;}
td{padding:12px 14px;border-bottom:1px solid #f1f5f9;font-size:13px;color:#475569;}
tr:hover td{background:#f8fafc;}
.te{text-align:center;padding:32px!important;color:#94a3b8!important;font-size:13px!important;}

/* SCAN */
.scanzone{border:2px dashed #cbd5e1;border-radius:16px;padding:36px;text-align:center;cursor:pointer;background:#f8fafc;transition:all .3s;}
.scanzone:hover{border-color:#3b82f6;background:#eff6ff;}
.scanzone.go{border-color:#0891b2;animation:sp .8s ease infinite;}
@keyframes sp{0%,100%{box-shadow:inset 0 0 0 rgba(8,145,178,0);}50%{box-shadow:inset 0 0 26px rgba(8,145,178,0.08);}}
.sz-ic{font-size:36px;margin-bottom:10px;}
.sz-t{font-size:16px;font-weight:700;margin-bottom:6px;color:#1e293b;}
.sz-h{font-size:11px;letter-spacing:2px;color:#94a3b8;}
.sres{margin-top:16px;border-radius:12px;padding:16px;display:none;}
.sres.show{display:block;}
.sr-v{background:#f0fdf4;border-left:4px solid #16a34a;}
.sr-e{background:#fffbeb;border-left:4px solid #d97706;}
.sr-b{background:#fef2f2;border-left:4px solid #dc2626;}
.sr-i{background:#f8fafc;border-left:4px solid #94a3b8;}

/* MISC */
.irow{display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;}
.irow .fg{flex:1;min-width:150px;margin-bottom:0;}
.wbox{padding:14px;border-radius:12px;margin-bottom:16px;background:#fffbeb;border:1px solid #fde68a;}
.ibox{padding:12px 14px;border-radius:11px;margin-bottom:14px;background:#eff6ff;border:1px solid #bfdbfe;font-size:13px;color:#3730a3;line-height:1.7;}
.pres{padding:14px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;margin-bottom:14px;display:none;}
.pres.show{display:block;}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
@media(max-width:520px){.g2{grid-template-columns:1fr;}}
.tbar{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:11px;margin-top:12px;}
.tbar span:last-child{font-size:18px;font-weight:800;color:#16a34a;}
.cinfo{padding:14px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;margin-bottom:14px;display:none;}
.cinfo.show{display:block;}
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:999;align-items:center;justify-content:center;padding:16px;}
.modal-bg.show{display:flex;}
.modal{background:#fff;border:1px solid #e2e8f0;border-radius:20px;padding:28px;width:100%;max-width:380px;box-shadow:0 20px 60px rgba(0,0,0,0.12);}
.modal h3{font-size:18px;font-weight:800;margin-bottom:12px;color:#1e293b;}
.mbtns{display:flex;gap:12px;justify-content:flex-end;margin-top:20px;}
@media(max-width:560px){.topbar{padding:10px 14px;}.dbody{padding:14px;}.srow{grid-template-columns:1fr 1fr;}.pcrow{gap:14px;}}

/* PHOTO UPLOAD */
.photo-upload-area{width:100%;border:2px dashed #cbd5e1;border-radius:14px;padding:20px;text-align:center;cursor:pointer;background:#f8fafc;transition:all .3s;position:relative;overflow:hidden;}
.photo-upload-area:hover{border-color:#3b82f6;background:#eff6ff;}
.photo-upload-area input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;z-index:10;}
.photo-preview{width:90px;height:90px;border-radius:50%;object-fit:cover;border:3px solid #3b82f6;display:none;margin:0 auto 8px;position:relative;z-index:1;pointer-events:none;}
.photo-preview.show{display:block;}
.photo-placeholder{font-size:40px;margin-bottom:8px;pointer-events:none;}
.photo-upload-txt{font-size:12px;color:#64748b;pointer-events:none;}
.photo-upload-hint{font-size:11px;color:#3b82f6;margin-top:4px;pointer-events:none;}
.photo-change-hint{font-size:11px;color:#16a34a;margin-top:6px;pointer-events:none;display:none;}
.photo-upload-area.has-photo .photo-change-hint{display:block;}
.photo-upload-area.has-photo .photo-upload-hint{display:none;}

/* QUICK AMOUNTS */
.quick-amounts{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px;}
.qa-btn{padding:6px 14px;border:1px solid #cbd5e1;border-radius:8px;background:#fff;color:#475569;font-size:12px;font-weight:600;cursor:pointer;transition:all .2s;font-family:inherit;}
.qa-btn:hover,.qa-btn.sel{border-color:#3b82f6;background:#eff6ff;color:#2563eb;}

/* FARE INFO BOX */
.fare-box{background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;padding:14px;margin-bottom:14px;}
.fare-box-title{font-size:11px;font-weight:700;letter-spacing:2px;color:#16a34a;margin-bottom:8px;}
.fare-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
.fare-item{background:#fff;border:1px solid #d1fae5;border-radius:8px;padding:10px;text-align:center;}
.fare-km{font-size:18px;font-weight:800;color:#16a34a;}
.fare-label{font-size:10px;color:#64748b;margin-top:2px;}
</style>
</head>
<body>

<!-- LANDING -->
<div id="landing" class="page active">
  <div class="brand-chip">TELANGANA GOVT</div>
  <h1 class="hero">TGRTC Smart<br>Bus Pass</h1>
  <p class="hero-sub">Digital bus pass — tap to verify, recharge online, block instantly.</p>
  <div class="pgrid">
    <div class="pcard" id="btnP">
      <div class="pcard-icon ic-b">🎫</div>
      <h3>PASSENGER</h3>
      <p>View pass, recharge online &amp; block lost card</p>
      <button class="pc-btn pb-b">PASSENGER LOGIN</button>
    </div>
    <div class="pcard" id="btnC">
      <div class="pcard-icon ic-g">🚌</div>
      <h3>CONDUCTOR</h3>
      <p>Scan RFID cards, verify &amp; collect cash recharges</p>
      <button class="pc-btn pb-g">CONDUCTOR LOGIN</button>
    </div>
    <div class="pcard" id="btnA">
      <div class="pcard-icon ic-y">⚙️</div>
      <h3>ADMIN</h3>
      <p>Manage passes, conductor reports &amp; controls</p>
      <button class="pc-btn pb-y">ADMIN LOGIN</button>
    </div>
  </div>
</div>

<!-- AUTH -->
<div id="auth" class="page">
  <div class="abox">
    <div id="authRole" class="role-chip rc-p">PASSENGER</div>
    <h2 id="authTitle">Welcome Back</h2>
    <div id="authSub" class="asub">Login to your account</div>
    <div id="authAlert" class="alert ae"></div>
    <div id="LF">
      <div class="fg"><label>PHONE NUMBER / USERNAME</label><input id="lPh" type="text" placeholder="10-digit phone number"></div>
      <div class="fg"><label>PASSWORD</label><input id="lPw" type="password" placeholder="Enter your password"></div>
      <button id="loginBtn" class="abtn">LOGIN →</button>
      <div id="suRow" class="alink">No account? <span id="goSU">Sign Up</span></div>
    </div>
    <div id="SF" style="display:none">
      <div class="fg" id="photoUploadGroup">
        <label>PROFILE PHOTO</label>
        <div class="photo-upload-area" id="photoArea">
          <input type="file" id="photoInput" accept="image/*">
          <img id="photoPreview" class="photo-preview" src="" alt="Preview">
          <div id="photoPlaceholder">
            <div class="photo-placeholder">📷</div>
            <div class="photo-upload-txt">Click to upload your photo</div>
            <div class="photo-upload-hint">JPG, PNG supported</div>
          </div>
          <div class="photo-change-hint">✅ Photo selected — click to change</div>
        </div>
      </div>
      <div class="fg"><label>FULL NAME</label><input id="sNm" type="text" placeholder="Full name"></div>
      <div class="fg"><label>PHONE NUMBER</label><input id="sPh" type="text" placeholder="10-digit phone"></div>
      <div class="fg" id="condRouteGroup" style="display:none">
        <label>ASSIGNED ROUTE</label>
        <select id="sRt">
          <option value="">-- Select Your Assigned Route --</option>
          <option value="288D">288D — Mehdipatnam → Chilkur Balaji Temple</option>
          <option value="505">505 — Mehdipatnam → Shankarpally</option>
        </select>
      </div>
      <div class="fg" id="cidFg" style="display:none"><label>CONDUCTOR STAFF ID</label><input id="sCid" type="text" placeholder="e.g. C-001"></div>
      <div class="fg"><label>PASSWORD</label><input id="sPw" type="password" placeholder="Min 4 characters"></div>
      <div class="fg"><label>CONFIRM PASSWORD</label><input id="sCf" type="password" placeholder="Confirm password"></div>
      <button id="signupBtn" class="abtn">CREATE ACCOUNT →</button>
      <div class="alink">Already have an account? <span id="goLF">Login</span></div>
    </div>
    <div id="backBtn" class="aback">← Back to Portal Selection</div>
  </div>
</div>

<!-- PASSENGER DASH -->
<div id="pDash" class="page">
  <div class="topbar">
    <div class="tb-left"><span class="tb-logo">🚌 TGRTC</span><span class="tb-chip rc-p">PASSENGER</span></div>
    <div class="tb-right"><span class="tb-user" id="pTbU">👤</span><button id="pLo" class="lobtn">LOGOUT</button></div>
  </div>
  <div class="dbody">
    <div class="dh">My Bus Pass</div>
    <div class="ds">Manage your TGRTC Smart Pass</div>
    <div class="pass-card">
      <div class="pch"><div class="pctag">TGRTC SMART BUS PASS</div><div id="pStat" class="pcst st-no">● NOT RECHARGED</div></div>
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:10px;">
        <div id="pcPhoto" class="pc-photo">👤</div>
        <div>
          <div id="pNm" class="pcname">PASSENGER NAME</div>
          <div id="pPid" class="pcid">Pass ID: —</div>
        </div>
      </div>
      <div class="pcrow">
        <div class="pci"><label>VALID TILL</label><span id="pExp" style="color:rgba(255,255,255,0.5)">Not Recharged</span></div>
        <div class="pci"><label>PASS TYPE</label><span id="pCt">—</span></div>
        <div class="pci" id="pRouteCi" style="display:none"><label>ROUTE</label><span id="pRtShow" style="color:#93c5fd">—</span></div>
        <div class="pci" id="pFareCi" style="display:none"><label>FARE PER TRIP</label><span id="pFareShow" style="color:#6ee7b7">—</span></div>
        <div class="pci" id="pBalCi"><label>WALLET BALANCE</label><span id="pBalShow" style="color:#6ee7b7">₹0</span></div>
      </div>
    </div>
    <div class="tabs">
      <button class="tb on" id="ptb0">💳 Recharge</button>
      <button class="tb" id="ptb1">🔒 Block / Unblock</button>
      <button class="tb" id="ptb2">📋 History</button>
    </div>
