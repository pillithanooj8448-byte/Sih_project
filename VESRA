function parseRoute(rv){
  if(!rv) return {no:'',display:'—',km:0};
  if(ROUTE_STOPS[rv]){
    var r=ROUTE_STOPS[rv];
    return {no:rv, display:r.name, km:r.stops[r.stops.length-1].km};
  }
  var parts=rv.split('|');
  return {no:parts[0]||'', display:parts[1]||rv, km:parseInt(parts[2])||0};
}

// ── DATA FUNCTIONS (Firebase Firestore + localStorage fallback) ──

// Users collection: doc per user key e.g. "9876543210_passenger"
function gU(cb){
  db.collection('tgrtc_users').get().then(function(snap){
    var users={};
    snap.forEach(function(doc){users[doc.id]=doc.data();});
    cb(users);
  }).catch(function(){
    try{cb(JSON.parse(localStorage.getItem('tgU')||'{}'));}catch(e){cb({});}
  });
}

function sUKey(key, data){
  // Save single user doc to Firestore
  db.collection('tgrtc_users').doc(key).set(data).catch(function(e){console.warn('Firebase save failed:',e);});
  // Also keep localStorage as backup
  try{
    var u=JSON.parse(localStorage.getItem('tgU')||'{}');
    u[key]=data;
    localStorage.setItem('tgU',JSON.stringify(u));
  }catch(e){}
}

function gUSync(){
  // Synchronous localStorage read for immediate UI needs
  try{return JSON.parse(localStorage.getItem('tgU')||'{}');}catch(e){return{};}
}

// Conductor history: doc per conductor phone
function gCH(ph,cb){
  db.collection('tgrtc_chistory').doc(ph).get().then(function(doc){
    cb(doc.exists?(doc.data().history||[]):[]);
  }).catch(function(){
    try{cb(JSON.parse(localStorage.getItem('ch_'+ph)||'[]'));}catch(e){cb([]);}
  });
}
function sCH(ph,h){
  db.collection('tgrtc_chistory').doc(ph).set({history:h}).catch(function(e){console.warn(e);});
  try{localStorage.setItem('ch_'+ph,JSON.stringify(h));}catch(e){}
}
function gCHSync(ph){try{return JSON.parse(localStorage.getItem('ch_'+ph)||'[]');}catch(e){return[];}}

// Passenger history
function gPH(ph,cb){
  db.collection('tgrtc_phistory').doc(ph).get().then(function(doc){
    cb(doc.exists?(doc.data().history||[]):[]);
  }).catch(function(){
    try{cb(JSON.parse(localStorage.getItem('ph_'+ph)||'[]'));}catch(e){cb([]);}
  });
}
function sPH(ph,h){
  db.collection('tgrtc_phistory').doc(ph).set({history:h}).catch(function(e){console.warn(e);});
  try{localStorage.setItem('ph_'+ph,JSON.stringify(h));}catch(e){}
}

function pg(id, persist){
  document.querySelectorAll('.page').forEach(function(p){p.classList.remove('active')});
  var target=document.getElementById(id);
  if(target) target.classList.add('active');
  if(persist!==false){
    try{sessionStorage.setItem('tgCurrentPage',id);}catch(e){}
  }
}

// Restore the last visible page after browser refresh. Authentication data is
// restored from localStorage so dashboard pages can be reconstructed safely.
function restorePageAfterRefresh(){
  var saved='';
  try{saved=sessionStorage.getItem('tgCurrentPage')||'';}catch(e){}
  if(!saved || saved==='landing') return;

  if(saved==='auth'){
    var savedRole='';
    try{savedRole=sessionStorage.getItem('tgRole')||'';}catch(e){}
    if(savedRole){goA(savedRole);}else{pg('landing',false);}
    return;
  }

  if(saved==='aDash'){
    me={name:'Admin',role:'admin'};
    loadAdmin();
    pg('aDash',false);
    return;
  }

  if(saved==='pDash' || saved==='cDash'){
    try{
      var savedKey=sessionStorage.getItem('tgLoginKey')||'';
      var users=JSON.parse(localStorage.getItem('tgU')||'{}');
      var user=users[savedKey];
      if(user && user.role){
        me=user;
        role=user.role;
        blk=user.blocked||false;
        if(role==='passenger' && saved==='pDash'){
          loadPDash(user);
          pg('pDash',false);
        }else if(role==='conductor' && saved==='cDash'){
          cst={t:0,v:0,i:0};crst={n:0,tot:0};
          el('cTbU').textContent='🎫 '+user.name+' ('+(user.condId||'')+')';
          var rt=parseRoute(user.route);
          el('cRtSub').textContent='Route: '+rt.no+' — '+rt.display+' | '+rt.km+' km';
          loadCHist();setTapUI(false);pg('cDash',false);
        }
      }
    }catch(e){}
  }
}

