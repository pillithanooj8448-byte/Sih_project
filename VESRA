var hwUnsubscribe = null;
var hwLastSeen = '';
var hwActive = false;

function setTapUI(active, message){
  hwActive = active;
  var z = el('szBtn');
  var hint = el('szHint');
  if(active){
    z.classList.add('go');
    z.querySelector('.sz-t').textContent = 'DEVICE ACTIVE — TAP RFID CARD';
    hint.textContent = message || 'RFID device active — waiting for card…';
  }else{
    z.classList.remove('go');
    z.querySelector('.sz-t').textContent = 'TAP HERE TO ACTIVATE DEVICE';
    hint.textContent = message || 'Device is off — tap here to start RFID listening';
  }
}

function setDeviceControl(active){
  var conductorId = me && me.condId ? String(me.condId) : 'L-009';
  return db.collection('tgrtc_device_control').doc(conductorId).set({
    active: !!active,
    conductorId: conductorId,
    route: me && me.route ? me.route : '288D',
    updatedAt: firebase.firestore.FieldValue.serverTimestamp()
  }, {merge:true});
}

function startHardwareListener(){
  stopHardwareListener();
  hwLastSeen = '';
  hwUnsubscribe = db.collection('tgrtc_scan_events')
    .orderBy('ts', 'desc')
    .limit(1)
    .onSnapshot(function(snap){
      if(snap.empty || !hwActive) return;
      var doc = snap.docs[0];
      var ev = doc.data();
      if(doc.id === hwLastSeen) return;
      hwLastSeen = doc.id;

      // Ignore events belonging to another conductor/device.
      var eventCid = String(ev.conductorId || '');
      var myCid = String(me && me.condId || '');
      if(eventCid && myCid && eventCid !== myCid) return;

      var z = el('szBtn');
      z.classList.add('go');
      setTimeout(function(){ z.classList.remove('go'); }, 800);

      var uid = ev.uid || '';
      var phone = ev.phone || '';
      var status = String(ev.status || '').toLowerCase();

      if(!phone || status === 'unknown' || status === 'nopass' || status === 'not registered'){
        showSR({t:'inv'});
        return;
      }

      db.collection('tgrtc_users').doc(phone+'_passenger').get().then(function(pdoc){
        if(!pdoc.exists){ showSR({t:'inv'}); return; }
        showSR({t:'ok', p:pdoc.data()});
      }).catch(function(){ showSR({t:'inv'}); });
    }, function(err){
      console.warn('Hardware listener error:', err);
      setTapUI(false, 'Connection error — tap to try again');
    });
}

function stopHardwareListener(){
  if(hwUnsubscribe){ hwUnsubscribe(); hwUnsubscribe=null; }
  hwLastSeen='';
}

function deactivateRFIDDevice(){
  setDeviceControl(false).catch(function(err){ console.warn('Device deactivation error:', err); });
  stopHardwareListener();
  setTapUI(false);
}

function activateRFIDDevice(){
  setDeviceControl(true).then(function(){
    setTapUI(true);
    startHardwareListener();
  }).catch(function(err){
    console.warn('Device activation error:', err);
    setTapUI(false, 'Could not activate device — check Firebase connection');
  });
}

