function loadPDash(u){
  el('pTbU').textContent='👤 '+u.name;
  var pcP=el('pcPhoto');
  if(pcP){
    if(u.photo&&u.photo.length>10){
      pcP.innerHTML='<img src="'+u.photo+'" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" alt="photo">';
    } else {
      pcP.textContent=u.name.charAt(0).toUpperCase();
    }
  }
  el('pNm').textContent=u.name.toUpperCase();
  el('pPid').textContent='Pass ID: '+u.passId;
  var bal=u.walletBalance||0;
  el('pBalShow').textContent='₹'+bal;
  if(el('walletDisp'))el('walletDisp').textContent='₹'+bal;
  var rt=parseRoute(u.route);
  if(u.blocked){
    setSt('bl');
    el('pRouteCi').style.display='none';el('pFareCi').style.display='none';el('pBalCi').style.display='block';
  } else if(u.expiry){
    setSt('on');
    el('pExp').textContent=u.expiry;el('pExp').style.color='#6ee7b7';
    el('pCt').textContent=u.cardType||'—';
    el('pRouteCi').style.display='block';el('pRtShow').textContent=rt.no+' — '+rt.display;
    el('pFareCi').style.display='block';
    var tripCost=rt.km*FARE_PER_KM;
    el('pFareShow').textContent='₹'+tripCost+' ('+rt.km+'km × ₹'+FARE_PER_KM+')';
    el('pBalCi').style.display='none';
    if(el('pFareInfo')){el('pFareInfo').style.display='block';el('fareKm').textContent=rt.km+' km';el('fareCost').textContent='₹'+tripCost;}
  } else {
    setSt('no');
    el('pRouteCi').style.display='none';el('pFareCi').style.display='none';el('pBalCi').style.display='block';
    if(el('pFareInfo'))el('pFareInfo').style.display='none';
  }
  updateBlkUI();loadPHist();
}

function setSt(s){
  var e=el('pStat');
  if(s==='on'){e.textContent='● ACTIVE';e.className='pcst st-on';}
  else if(s==='bl'){e.textContent='● BLOCKED';e.className='pcst st-bl';}
  else{e.textContent='● NOT RECHARGED';e.className='pcst st-no';el('pExp').textContent='Not Recharged';el('pExp').style.color='rgba(255,255,255,0.45)';el('pCt').textContent='—';}
}

